{
  "name": "sqi-ui",
  "version": "0.0.1",
  "description": "My react component library",
  "keywords": [],
  "author": "jsonq",
  "license": "MIT",
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "lefthook install",
    "dev": "turbo dev --filter=./packages/**",
    "build": "turbo build --filter=./packages/**",
    "format": "pnpm -r --filter=./packages/** format",
    "format-staged": "pnpm -r --filter=./packages/** format-staged",
    "clean": "rimraf .turbo && pnpm -r --filter=./packages/** clean"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@rslib/core": "^0.18.3",
    "@sqi-ui/tsconfig": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.15",
    "fs-extra": "^11.3.2",
    "jsdom": "^27.2.0",
    "lefthook": "^1.13.6",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "tsx": "^4.21.0",
    "turbo": "^2.6.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
