{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "storybook-static/**",
        "**/docs-dist/**",
        "!.next/cache/**",
        "**/dist/**",
        "**/es/**",
        "**/lib/**"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "packages/**/src/**",
        "packages/**/package.json",
        "packages/**/tsconfig.json",
        "packages/**/rslib.config.ts",
        "packages/**/gulpfile.js"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "format-staged": {
      "dependsOn": ["^format-staged"]
    },
    "clean": {
      "cache": false
    }
  }
}
